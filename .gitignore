# python
__pycache__/
*.pyc
.venv/

# venvs created for OpenFrontier / SAM3 / depth models
sam3-venv/
*-venv/
openfrontier-venv/

# training outputs
dump/

# ---- eval outputs & big data (keep eval/*.py scripts + small *.jsonl/*.csv results tracked) ----
eval/planning_runs/
eval/runs/
eval/*_out/
eval/*_gpu*/
eval/drive_imagine_out/
eval/imagine_spawn_out/
eval/teleop_session*/
eval/smoke_videos/
eval/**/videos/
eval/*.log

# large binaries anywhere (videos, images, arrays, checkpoints)
*.mp4
*.avi
*.mkv
*.png
*.jpg
*.jpeg
*.npy
*.pth
*.pt
*.ckpt

# ---- embedded repos: intentionally NOT ignored (tracked separately / as gitlinks) ----
#   OpenFrontier/
#   cosmos/
#   FrontierNet/

# big meshes
*.glb
*.ply
*.obj

# vendored third-party repos: exclude their heavy/generated dirs
OpenFrontier/third_party/
OpenFrontier/output/
OpenFrontier/data/
OpenFrontier/data_scenes/
OpenFrontier/model_weights/
FrontierNet/model_weights/
FrontierNet/assets/
FrontierNet/examples/
cosmos/**/checkpoints/
cosmos/**/*.safetensors
